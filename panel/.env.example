# Copy to .env.local. Local stack values come from `supabase status` (API URL and the publishable key).
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Local development only: shows an e-mail magic link / one-time code form on /panel/giris.
# Production builds ignore it (the form is compiled out), so staff always sign in with Google there.
VITE_PANEL_DEV_EMAIL_LOGIN=false
