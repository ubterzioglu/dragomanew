# Build-time settings. Copy the lines you need into .env.local (git-ignored) or set
# them in the host's build environment; values already in the environment win.

# Origin used for canonical and hreflang URLs. https only, no path. Default: https://dragoman-turkey.com
# Temporary host first, own domain later:
# VITE_SITE_ORIGIN=https://notyetbro.club

# Leave unset for Stage A: every page stays noindex and robots.txt disallows everything.
# VITE_PUBLIC_RELEASE=true
