# Settings for the submit-request Edge Function: LOCAL example values only.
# The hosts and origins below (inbucket, localhost) belong to the CLI's Docker setup. Never
# push this file to production as is, e.g. with `supabase secrets set --env-file ...`:
# set each production secret by hand (Dashboard or `supabase secrets set NAME=value`).
# Production needs: ALLOWED_ORIGINS, THROTTLE_SALT, BUSINESS_EMAIL, PANEL_URL, MAIL_FROM,
# SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS, SMTP_SECURE.
#
# Local: copy to supabase/functions/.env (git-ignored) and run
#   supabase functions serve submit-request --env-file supabase/functions/.env
# SUPABASE_URL and the publishable/secret keys are provided by the CLI and the platform.
# Never commit real values.

# Comma-separated origins allowed to call the function (exact match, no trailing slash).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173

# Only an HMAC of the visitor IP is stored for rate limiting. En az 32 rastgele karakter;
# yerelde de üretin (e.g. `openssl rand -hex 32`). The function refuses to start on a shorter
# value or on a placeholder.
THROTTLE_SALT=

# Receives the Turkish "new request" mail; leave empty to skip it.
BUSINESS_EMAIL=info@example.com
# Link in that mail.
PANEL_URL=http://127.0.0.1:5175/panel/

# A missing SMTP_HOST or MAIL_FROM (or only one of SMTP_USER/SMTP_PASS) does not stop the
# function: requests are still stored and their outbox rows end as failed (smtp_not_configured).
# Production: Zoho on implicit TLS (Supabase blocks ports 25 and 587).
#   SMTP_HOST=smtp.zoho.eu  SMTP_PORT=465  SMTP_SECURE=true  SMTP_USER=...  SMTP_PASS=...
# Local: Mailpit inside the CLI's Docker network, no TLS, no auth. Its web UI is the
# "Mailpit URL" in `supabase status`; SMTP listens on 1025 inside the network. Use the
# network alias `inbucket`: the edge runtime's resolver rejects the container name
# (supabase_inbucket_<project>, with underscores) as getaddrinfo ENOTFOUND.
SMTP_HOST=inbucket
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Dragoman <no-reply@example.com>

# --- Dalga 2: publish-content, translate-content, content-release, site-deploy -------------
# Local: supabase functions serve --env-file supabase/functions/.env (ALLOWED_ORIGINS above is
# shared; add the panel origin, e.g. http://127.0.0.1:5175). Production sets each by hand.

# DeepL key for translate-content. Keys ending in ":fx" use api-free.deepl.com. Never commit,
# print or log it; leave empty here and put the real value only into the git-ignored .env.
DEEPL_API_KEY=

# site-deploy: pg_net sends this in x-dispatch-secret (Vault deploy_dispatch_secret must hold the
# same value). At least 32 random characters, e.g. `openssl rand -hex 32`. Empty = every call 401.
DEPLOY_DISPATCH_SECRET=

# Coolify Deploy Webhook (https only; force is always sent as false) and an API token that can
# deploy only this application. Both empty (the local default) = deploys end skipped/not_configured.
COOLIFY_DEPLOY_URL=
COOLIFY_API_TOKEN=
